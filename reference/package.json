{
  "name": "@certconcord/reference",
  "version": "0.3.0-draft.1",
  "private": true,
  "description": "CertConcord working-draft reference implementation",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 *.test.mjs",
    "demo": "node foundation-demo.mjs",
    "demo:mtc": "node demo.mjs",
    "demo:document": "node document-demo.mjs",
    "start": "node server.mjs",
    "check": "node ../tools/check.mjs",
    "demo:passkey": "node passkey-demo.mjs",
    "test:postgres": "node --test --test-concurrency=1 --test-timeout=60000 storage/postgres.test.mjs",
    "fuzz:seed": "node fuzz/seed.mjs",
    "fuzz:replay": "node fuzz/replay.mjs",
    "fuzz": "node fuzz/run.mjs",
    "benchmark": "node benchmarks/run.mjs",
    "privacy": "node benchmarks/privacy.mjs",
