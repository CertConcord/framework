    "cbor-x": "1.6.6",
    "koffi": "3.3.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "xml-crypto": "6.3.2"
  },
  "devDependencies": {
    "@jazzer.js/core": "4.0.0",
